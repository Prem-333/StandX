{
  "name": "procurement-standards-scaffold",
  "private": true,
  "description": "Phase demonstration commands; frontend dependencies are not selected yet.",
  "scripts": {
    "phase0-demo": "python scripts/phase0_demo.py",
    "phase1-demo": "python scripts/phase1_demo.py",
    "phase2-demo": "node scripts/phase2_demo.mjs",
    "phase3-demo": "python scripts/phase3_demo.py",
    "phase4-demo": "python scripts/phase4_demo.py",
    "phase5-demo": "node scripts/phase5_demo.mjs",
    "phase6-demo": "python scripts/phase6_demo.py",
    "phase7-demo": "node scripts/local_backend_demo.mjs scripts/phase7_demo.py",
    "phase8-demo": "node scripts/local_backend_demo.mjs scripts/phase8_demo.py",
    "translation:provision": "python scripts/provision_translation.py",
    "api:local": "node scripts/local_backend_demo.mjs scripts/serve_api.py",
    "test": "python -m unittest discover -s eval -p test_*.py -v",
    "models:provision": "python scripts/provision_models.py",
    "seed:build": "python scripts/build_seed.py",
    "kb:validate": "python -m services.ingestion.validate --output data/processed/validation_report.json",
    "phase9-demo": "node scripts/phase9_demo.mjs",
    "phase9-test": "node scripts/phase9_demo.mjs --test",
    "phase10-demo": "python -X utf8 eval/run_eval.py",
    "eval:retrain": "python -X utf8 scripts/retrain_reranker.py",
    "frontend:build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11"
  }
}
