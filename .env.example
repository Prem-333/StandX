# Export values for CLI tools; scripts/serve_api.py and Compose load .env.
# Never commit credentials. Most retrieval settings live in the JSON file below.
APP_ENV=development
# Explicit local PostgreSQL connection for services.ingestion.load:
DATABASE_URL=
# Optional path override; defaults to this file automatically:
RETRIEVAL_CONFIG=kb/retrieval_config.json
# Phase 5 thresholds, score space, synthetic policy, and phrase limits:
RECOMMENDATION_CONFIG=services/recommendation/config.json
# Compose supplies Neo4j settings; local development defaults to NetworkX:
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
# Compose: generate real secrets with python scripts/setup_local_env.py.
POSTGRES_PASSWORD=
API_KEYS_JSON=
API_RATE_LIMIT=30
MULTILINGUAL_CONFIG=services/nlp/multilingual_config.json
CERTIFICATION_RULES_PATH=data/processed/certification_rules.json

# Bounded local model queue per process; excess recommendations return 503.
API_MAX_INFLIGHT=4
